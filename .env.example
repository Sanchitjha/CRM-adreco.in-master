# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection (matches docker-compose.yml for local dev)
DATABASE_URL="postgresql://adreco:adreco_dev_password@localhost:5432/adreco_crm"

# Auth.js — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
# Leave AUTH_URL unset for local dev (trustHost:true infers it from the request).
# Set it to the real domain in production, e.g. https://crm.adreco.in
AUTH_URL=""

# AWS S3 (document storage) — leave blank locally until Phase 4 needs it
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME=""

# SMTP (follow-up email digest) — leave blank locally until Phase 6 needs it
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Adreco CRM <no-reply@adreco.in>"

# Shared secret the OS-level cron job must send to trigger /api/cron/digest
CRON_SECRET=""

# AI Intelligence & Copilot Engine (Google Gemini default, or OpenAI)
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# WhatsApp Integration (Meta WhatsApp Cloud API or Zoho proxy)
# Direct WhatsApp Click-to-Chat works instantly with 0 keys!
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Zoho CRM & Zoho Ecosystem Integration
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
ZOHO_REFRESH_TOKEN=""
ZOHO_ACCOUNTS_DOMAIN="https://accounts.zoho.in"
ZOHO_API_DOMAIN="https://www.zohoapis.in"
ZOHO_WEBHOOK_SECRET=""
ZOHO_WHATSAPP_WEBHOOK_URL=""

