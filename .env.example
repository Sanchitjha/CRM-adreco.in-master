# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection (matches docker-compose.yml for local dev).
# On AWS RDS use e.g. postgresql://USER:PASSWORD@HOST:5432/adreco_crm?sslmode=require&connection_limit=5
DATABASE_URL="postgresql://adreco:adreco_dev_password@localhost:5432/adreco_crm"

# Auth.js — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
# Leave AUTH_URL unset for local dev (trustHost:true infers it from the request).
# Set it to the real domain in production, e.g. https://crm.adreco.in
AUTH_URL=""

# First-time production seeding only (see DEPLOYMENT.md). Creates ONE administrator, who must choose a new
# password at first sign-in. Never used by the running app. Without SEED_MODE=production the seed script
# creates six demo accounts with a shared password, which is for local development only.
SEED_MODE=""
SEED_ADMIN_EMAIL="admin@adreco.in"
SEED_ADMIN_NAME="Administrator"
# At least 12 characters, with a letter and a number.
SEED_ADMIN_PASSWORD=""
# A demo or test copy with dummy data: SEED_MODE="demo" instead creates one account per role, all signing in with this
# password (at least 12 characters, with a letter and a number), plus sample products and 40 made-up prospects.
SEED_DEMO_PASSWORD=""

# AWS S3 (document storage). On AWS prefer an instance/task IAM role and leave the key pair blank.
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME=""

# Mail: the morning digest, the administrators' daily update and the emails employees send to leads.
# With AWS SES: email-smtp.<region>.amazonaws.com, port 587 (see DEPLOYMENT.md, section 5a).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# What customers see as the sender. Any address on the verified domain.
SMTP_FROM="Adreco Engineering <sales@adreco.in>"
# Optional: send each email from the employee's own address instead, when it is on the same domain as SMTP_FROM.
MAIL_FROM_EMPLOYEE="false"
# Optional: every email an employee sends to a lead is also copied to this address, for the company's records.
MAIL_ARCHIVE_BCC=""
# Optional: the address people use to reach the CRM, for the links in emails. Falls back to AUTH_URL.
APP_URL=""

# Shared secret the scheduler must send (header x-cron-secret) to trigger POST /api/cron/digest
CRON_SECRET=""

# AI Intelligence & Copilot Engine (Google Gemini default, or OpenAI). Deal scores work without a key;
# generated advice and messages need one.
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# WhatsApp Business API (Meta's official Cloud API). Used only to send the administrators' daily update as an
# approved template message; see DEPLOYMENT.md, section 5b. Without these the update comes by email and on the
# dashboard only. The "WhatsApp" buttons on leads need no key: they open WhatsApp with the message ready.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_API_VERSION="v22.0"
WHATSAPP_REPORT_TEMPLATE="daily_crm_update"
WHATSAPP_REPORT_LANGUAGE="en"

# Optional: lets a web form or another system post new enquiries to POST /api/integrations/zoho/webhook (the name is
# historical). The address is public, so it refuses every call until this is set; the sender must then send the same
# value in an "x-zoho-secret" header.
ZOHO_WEBHOOK_SECRET=""
