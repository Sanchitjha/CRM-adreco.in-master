{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "adreco-crm-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "adreco-crm-local-copy",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "C:/dev/adreco-crm", "run", "dev"],
      "port": 3000,
      "autoPort": true
    }
  ]
}
