generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
  DESIGN
  ACCOUNTS
  INSTALLATION
  SERVICE
}

enum LeadStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  QUOTED
  CONVERTED
  LOST
}

enum StageStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum DocumentStatus {
  REQUIRED
  RECEIVED
  SUBMITTED
  APPROVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum SurveyStatus {
  DRAFT
  SUBMITTED
  REVIEWED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  departmentId String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  /// Set when an administrator creates the account or resets its password: the user must choose their own
  /// password before using the CRM.
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?
  lastLoginAt        DateTime?

  department Department? @relation(fields: [departmentId], references: [id])

  leadsCreated      Lead[]                  @relation("LeadCreatedBy")
  leadsAssigned     Lead[]                  @relation("LeadAssignedTo")
  followUps         FollowUp[]
  departmentStages  LeadDepartmentHistory[] @relation("StageAssignedTo")
  documentsUploaded Document[]
  tasksAssigned     Task[]                  @relation("TaskAssignedTo")
  tasksCreated      Task[]                  @relation("TaskAssignedBy")
  activityLogs      ActivityLog[]
  notifications     Notification[]
  siteSurveys       SiteSurvey[]            @relation("SurveyBy")
  quotations        Quotation[]             @relation("QuoteBy")

  salesOrders           SalesOrder[]    @relation("OrderBy")
  installationsCreated  Installation[]  @relation("InstallBy")
  installationsAssigned Installation[]  @relation("InstallTech")
  commissionings        Commissioning[] @relation("CommissionBy")
  ticketsRaised         ServiceTicket[] @relation("TicketBy")
  ticketsAssigned       ServiceTicket[] @relation("TicketTech")
  claimsRaised          WarrantyClaim[] @relation("ClaimBy")
  claimsDecided         WarrantyClaim[] @relation("ClaimDecidedBy")
  amcContracts          AmcContract[]   @relation("AmcBy")
  amcVisits             AmcVisit[]      @relation("AmcVisitTech")

  @@index([role])
  @@index([departmentId])
}

/// One row per failed sign-in, used to lock an account (or an address) out for a while after repeated failures.
/// Rows are cleared when the person signs in successfully and purged by the daily digest job.
model LoginFailure {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @unique
  createdAt DateTime @default(now())

  users              User[]
  leadsCurrentlyHere Lead[]                  @relation("LeadCurrentDepartment")
  history            LeadDepartmentHistory[]
}

model Lead {
  id               String     @id @default(cuid())
  customerName     String
  phone            String
  email            String?
  address          String?
  productCategory  String?
  requirementNotes String?
  budget           Decimal?   @db.Decimal(12, 2)
  source           String?
  status           LeadStatus @default(NEW)

  createdById String
  createdBy   User   @relation("LeadCreatedBy", fields: [createdById], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("LeadAssignedTo", fields: [assignedToId], references: [id])

  currentDepartmentId String?
  currentDepartment   Department? @relation("LeadCurrentDepartment", fields: [currentDepartmentId], references: [id])

  createdAt   DateTime  @default(now())
  convertedAt DateTime?

  followUps        FollowUp[]
  departmentStages LeadDepartmentHistory[]
  documents        Document[]
  tasks            Task[]
  siteSurveys      SiteSurvey[]
  quotations       Quotation[]

  dealerId String?
  dealer   Dealer? @relation(fields: [dealerId], references: [id])

  salesOrders   SalesOrder[]
  installations Installation[]
  serialNumbers SerialNumber[]
  tickets       ServiceTicket[]
  amcContracts  AmcContract[]

  @@index([status])
  @@index([assignedToId])
  @@index([currentDepartmentId])
  @@index([dealerId])
}

model SiteSurvey {
  id           String @id @default(cuid())
  leadId       String
  lead         Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  surveyedById String
  surveyedBy   User   @relation("SurveyBy", fields: [surveyedById], references: [id])

  // Requirement
  application      String
  siteAddress      String?
  ambientTempC     Int?
  requiredTempC    Int?
  dailyDemandL     Int?
  peakHourL        Int?
  numberOfUsers    Int?
  poolSize         String?
  existingSystem   String?
  electricalSupply String?
  installLocation  String?
  pipingDetails    String?
  storageTank      String?

  // Recommendation
  recommendedModel      String?
  recommendedCapacityKw Int?
  recommendedQty        Int?
  engineerRemarks       String?

  status     SurveyStatus @default(DRAFT)
  surveyDate DateTime     @default(now())
  createdAt  DateTime     @default(now())

  quotations Quotation[]

  @@index([leadId])
  @@index([status])
  @@index([surveyedById])
}

model Quotation {
  id           String      @id @default(cuid())
  quoteNumber  String      @unique
  leadId       String
  lead         Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  siteSurveyId String?
  siteSurvey   SiteSurvey? @relation(fields: [siteSurveyId], references: [id])
  createdById  String
  createdBy    User        @relation("QuoteBy", fields: [createdById], references: [id])

  status             QuoteStatus @default(DRAFT)
  discountPct        Decimal     @default(0) @db.Decimal(5, 2)
  gstPct             Decimal     @default(18) @db.Decimal(5, 2)
  installationCharge Decimal     @default(0) @db.Decimal(12, 2)
  transportCharge    Decimal     @default(0) @db.Decimal(12, 2)
  subtotal           Decimal     @default(0) @db.Decimal(12, 2)
  grandTotal         Decimal     @default(0) @db.Decimal(12, 2)
  validUntil         DateTime?
  notes              String?
  terms              String?
  createdAt          DateTime    @default(now())

  items      QuotationItem[]
  salesOrder SalesOrder?

  @@index([leadId])
  @@index([status])
  @@index([createdById])
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  description String
  quantity    Int       @default(1)
  unitPrice   Decimal   @db.Decimal(12, 2)
  lineTotal   Decimal   @db.Decimal(12, 2)

  @@index([quotationId])
}

model FollowUp {
  id               String    @id @default(cuid())
  leadId           String
  lead             Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  note             String
  followUpDate     DateTime  @default(now())
  nextFollowUpDate DateTime?
  outcome          String?
  createdAt        DateTime  @default(now())

  @@index([leadId])
  @@index([nextFollowUpDate])
}

model LeadDepartmentHistory {
  id           String      @id @default(cuid())
  leadId       String
  lead         Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id])
  assignedToId String?
  assignedTo   User?       @relation("StageAssignedTo", fields: [assignedToId], references: [id])
  status       StageStatus @default(PENDING)
  notes        String?
  enteredAt    DateTime    @default(now())
  completedAt  DateTime?

  @@index([leadId])
  @@index([departmentId])
}

model Document {
  id           String         @id @default(cuid())
  leadId       String
  lead         Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  docType      String
  s3Key        String?
  fileName     String?
  status       DocumentStatus @default(REQUIRED)
  uploadedById String?
  uploadedBy   User?          @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime?
  notes        String?
  createdAt    DateTime       @default(now())

  @@index([leadId])
}

model Task {
  id           String       @id @default(cuid())
  title        String
  description  String?
  assignedToId String
  assignedTo   User         @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  assignedById String
  assignedBy   User         @relation("TaskAssignedBy", fields: [assignedById], references: [id])
  leadId       String?
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  dueDate      DateTime?
  status       TaskStatus   @default(TODO)
  priority     TaskPriority @default(MEDIUM)
  createdAt    DateTime     @default(now())

  @@index([assignedToId])
  @@index([status])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  message   String
  leadId    String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

/**
 * ============================================================================
 * Customer lifecycle: catalog → order → install → commission → service
 * ==========================================================================
 */

enum SalesOrderStatus {
  CONFIRMED
  IN_PRODUCTION
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum InstallationStatus {
  PENDING
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CommissioningStatus {
  IN_PROGRESS
  COMPLETED
}

enum SerialStatus {
  IN_STOCK
  DISPATCHED
  INSTALLED
  COMMISSIONED
  SCRAPPED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  OPEN
  ASSIGNED
  VISIT
  DIAGNOSIS
  PARTS
  REPAIR
  CLOSED
}

enum ClaimStatus {
  SUBMITTED
  APPROVED
  REJECTED
  RESOLVED
}

enum AmcStatus {
  ACTIVE
  CANCELLED
}

enum AmcVisitStatus {
  SCHEDULED
  COMPLETED
  SKIPPED
}

model Product {
  id          String  @id @default(cuid())
  name        String
  modelCode   String  @unique
  category    String?
  series      String?
  description String?
  isSparePart Boolean @default(false)

  heatingCapacityKw Decimal? @db.Decimal(8, 2)
  inputPowerKw      Decimal? @db.Decimal(8, 2)
  cop               Decimal? @db.Decimal(5, 2)
  refrigerant       String?
  compressor        String?
  operatingRange    String?
  heatExchanger     String?
  warrantyMonths    Int      @default(12)

  dealerPrice   Decimal? @db.Decimal(12, 2)
  customerPrice Decimal? @db.Decimal(12, 2)
  stockQty      Int      @default(0)
  datasheetUrl  String?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serialNumbers SerialNumber[]
  ticketParts   TicketPart[]
  dealerStock   DealerStock[]

  @@index([category])
  @@index([series])
  @@index([active])
}

model SalesOrder {
  id          String     @id @default(cuid())
  orderNumber String     @unique
  leadId      String
  lead        Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  quotationId String?    @unique
  quotation   Quotation? @relation(fields: [quotationId], references: [id])
  createdById String
  createdBy   User       @relation("OrderBy", fields: [createdById], references: [id])

  status           SalesOrderStatus @default(CONFIRMED)
  orderDate        DateTime         @default(now())
  deliveryDate     DateTime?
  paymentTerms     String?
  customerPoNumber String?
  billingAddress   String?
  shippingAddress  String?

  // Commercial snapshot taken from the accepted quotation.
  subtotal           Decimal @default(0) @db.Decimal(12, 2)
  discountPct        Decimal @default(0) @db.Decimal(5, 2)
  gstPct             Decimal @default(18) @db.Decimal(5, 2)
  installationCharge Decimal @default(0) @db.Decimal(12, 2)
  transportCharge    Decimal @default(0) @db.Decimal(12, 2)
  grandTotal         Decimal @default(0) @db.Decimal(12, 2)
  amountReceived     Decimal @default(0) @db.Decimal(12, 2)

  // Dispatch
  transporter  String?
  lrNumber     String?
  ewayBillNo   String?
  dispatchedAt DateTime?
  deliveredAt  DateTime?

  notes     String?
  createdAt DateTime @default(now())

  items         SalesOrderItem[]
  serialNumbers SerialNumber[]
  installations Installation[]

  @@index([leadId])
  @@index([status])
  @@index([createdById])
}

model SalesOrderItem {
  id          String     @id @default(cuid())
  orderId     String
  order       SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  description String
  quantity    Int        @default(1)
  unitPrice   Decimal    @db.Decimal(12, 2)
  lineTotal   Decimal    @db.Decimal(12, 2)

  @@index([orderId])
}

model SerialNumber {
  id             String       @id @default(cuid())
  serialNo       String       @unique
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  status         SerialStatus @default(IN_STOCK)
  manufacturedOn DateTime?

  // Current owner. Set when the unit is dispatched on an order (or registered as an existing installation).
  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id])

  salesOrderId String?
  salesOrder   SalesOrder? @relation(fields: [salesOrderId], references: [id])
  dispatchedAt DateTime?

  installationId String?
  installation   Installation? @relation(fields: [installationId], references: [id])
  installedAt    DateTime?

  commissionedAt   DateTime?
  warrantyStartsOn DateTime?
  warrantyEndsOn   DateTime?

  notes     String?
  createdAt DateTime @default(now())

  tickets  ServiceTicket[]
  claims   WarrantyClaim[]
  amcUnits AmcUnit[]

  @@index([productId])
  @@index([status])
  @@index([leadId])
  @@index([salesOrderId])
  @@index([installationId])
  @@index([warrantyEndsOn])
}

model Installation {
  id           String      @id @default(cuid())
  jobNumber    String      @unique
  leadId       String
  lead         Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  salesOrderId String?
  salesOrder   SalesOrder? @relation(fields: [salesOrderId], references: [id])
  createdById  String
  createdBy    User        @relation("InstallBy", fields: [createdById], references: [id])
  technicianId String?
  technician   User?       @relation("InstallTech", fields: [technicianId], references: [id])

  status        InstallationStatus @default(PENDING)
  siteAddress   String?
  contactPerson String?
  contactPhone  String?
  scheduledFor  DateTime?
  startedAt     DateTime?
  completedAt   DateTime?

  /// [{ id, label, done }]
  checklist Json    @default("[]")
  remarks   String?

  customerSignedBy String?
  customerSignedAt DateTime?
  createdAt        DateTime  @default(now())

  serialNumbers SerialNumber[]
  commissioning Commissioning?

  @@index([leadId])
  @@index([status])
  @@index([technicianId])
  @@index([salesOrderId])
}

model Commissioning {
  id             String       @id @default(cuid())
  reportNumber   String       @unique
  installationId String       @unique
  installation   Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  engineerId     String?
  engineer       User?        @relation("CommissionBy", fields: [engineerId], references: [id])

  status CommissioningStatus @default(IN_PROGRESS)

  /// [{ id, label, result: "PENDING" | "PASS" | "FAIL", reading }]
  checklist Json @default("[]")

  customerDemoDone   Boolean   @default(false)
  customerApprovedBy String?
  customerApprovedAt DateTime?
  engineerRemarks    String?
  commissionedOn     DateTime?
  createdAt          DateTime  @default(now())

  @@index([status])
  @@index([engineerId])
}

model ServiceTicket {
  id             String        @id @default(cuid())
  ticketNumber   String        @unique
  leadId         String
  lead           Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  serialNumberId String?
  serialNumber   SerialNumber? @relation(fields: [serialNumberId], references: [id])

  subject       String
  description   String?
  complaintType String?
  priority      TicketPriority @default(MEDIUM)
  status        TicketStatus   @default(OPEN)
  slaDueAt      DateTime?

  createdById  String
  createdBy    User    @relation("TicketBy", fields: [createdById], references: [id])
  assignedToId String?
  assignedTo   User?   @relation("TicketTech", fields: [assignedToId], references: [id])

  visitScheduledFor   DateTime?
  checkedInAt         DateTime?
  diagnosis           String?
  resolution          String?
  customerSignedOffBy String?
  closedAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parts  TicketPart[]
  claims WarrantyClaim[]

  @@index([leadId])
  @@index([status])
  @@index([priority])
  @@index([assignedToId])
  @@index([serialNumberId])
}

model TicketPart {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    ServiceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  productId String
  product   Product       @relation(fields: [productId], references: [id])
  quantity  Int           @default(1)
  createdAt DateTime      @default(now())

  @@index([ticketId])
  @@index([productId])
}

model WarrantyClaim {
  id             String         @id @default(cuid())
  claimNumber    String         @unique
  serialNumberId String
  serialNumber   SerialNumber   @relation(fields: [serialNumberId], references: [id])
  ticketId       String?
  ticket         ServiceTicket? @relation(fields: [ticketId], references: [id])

  issue        String
  claimedParts String?
  status       ClaimStatus @default(SUBMITTED)
  decisionNote String?
  resolution   String?

  createdById String
  createdBy   User      @relation("ClaimBy", fields: [createdById], references: [id])
  decidedById String?
  decidedBy   User?     @relation("ClaimDecidedBy", fields: [decidedById], references: [id])
  decidedAt   DateTime?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([serialNumberId])
  @@index([status])
  @@index([ticketId])
}

model AmcContract {
  id             String @id @default(cuid())
  contractNumber String @unique
  leadId         String
  lead           Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User   @relation("AmcBy", fields: [createdById], references: [id])

  status        AmcStatus @default(ACTIVE)
  startDate     DateTime
  endDate       DateTime
  visitsPerYear Int       @default(2)
  amount        Decimal   @default(0) @db.Decimal(12, 2)
  coveredParts  String?
  notes         String?

  renewedFromId String?
  renewedFrom   AmcContract?  @relation("AmcRenewal", fields: [renewedFromId], references: [id])
  renewals      AmcContract[] @relation("AmcRenewal")

  createdAt DateTime @default(now())

  units  AmcUnit[]
  visits AmcVisit[]

  @@index([leadId])
  @@index([status])
  @@index([endDate])
}

model AmcUnit {
  amcId          String
  amc            AmcContract  @relation(fields: [amcId], references: [id], onDelete: Cascade)
  serialNumberId String
  serialNumber   SerialNumber @relation(fields: [serialNumberId], references: [id])

  @@id([amcId, serialNumberId])
  @@index([serialNumberId])
}

model AmcVisit {
  id           String         @id @default(cuid())
  amcId        String
  amc          AmcContract    @relation(fields: [amcId], references: [id], onDelete: Cascade)
  scheduledFor DateTime
  status       AmcVisitStatus @default(SCHEDULED)
  technicianId String?
  technician   User?          @relation("AmcVisitTech", fields: [technicianId], references: [id])
  completedAt  DateTime?
  notes        String?

  @@index([amcId])
  @@index([status, scheduledFor])
}

model Dealer {
  id                 String   @id @default(cuid())
  code               String?  @unique
  name               String
  contactPerson      String?
  phone              String?
  email              String?
  address            String?
  city               String?
  state              String?
  territory          String?
  gstin              String?
  outstandingBalance Decimal  @default(0) @db.Decimal(12, 2)
  notes              String?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())

  leads   Lead[]
  targets DealerTarget[]
  stock   DealerStock[]

  @@index([territory])
  @@index([active])
}

model DealerTarget {
  id           String   @id @default(cuid())
  dealerId     String
  dealer       Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  periodLabel  String
  startDate    DateTime
  endDate      DateTime
  targetAmount Decimal  @db.Decimal(14, 2)
  incentivePct Decimal  @default(0) @db.Decimal(5, 2)
  createdAt    DateTime @default(now())

  @@index([dealerId])
}

model DealerStock {
  id        String  @id @default(cuid())
  dealerId  String
  dealer    Dealer  @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(0)

  @@unique([dealerId, productId])
  @@index([productId])
}

/**
 * ----------------------------------------------------------------------------
 * Settings & helpers
 * --------------------------------------------------------------------------
 */

model CompanyProfile {
  id          String   @id @default("singleton")
  legalName   String
  tradeName   String?
  gstin       String?
  pan         String?
  address     String?
  city        String?
  state       String?
  pincode     String?
  phone       String?
  email       String?
  website     String?
  logoUrl     String?
  bankDetails String?
  updatedAt   DateTime @updatedAt
}

/// Editable pick-lists: lead sources, payment terms, product categories, complaint types, territories, warranty periods.
model SettingOption {
  id        String  @id @default(cuid())
  group     String
  value     String
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  @@unique([group, value])
  @@index([group])
}

model SlaPolicy {
  priority        TicketPriority @id
  resolutionHours Int
}

/// Gap-tolerant, race-free counters for human-readable document numbers (SO-2026-0001).
model Sequence {
  key   String @id
  value Int    @default(0)
}
